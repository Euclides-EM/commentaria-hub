{
  "name": "commentaria-apps-workspace",
  "private": true,
  "workspaces": [
    "commentaria-app",
    "elements-resource-box",
    "hub-api"
  ],
  "scripts": {
    "dev:all": "yarn workspaces foreach -Api --exclude hub-api run dev",
    "build:all": "yarn workspaces foreach -Ap run build",
    "lint:all": "yarn workspaces foreach -Ap run lint",
    "format:all": "yarn workspaces foreach -Ap run format",
    "gen-api": "yarn workspace hub-api run gen-api"
  },
  "packageManager": "yarn@4.12.0"
}
